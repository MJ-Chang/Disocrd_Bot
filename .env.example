# ===== Discord Bot 設定 =====
# Bot Token（Discord Developer Portal -> Bot -> Token）
TOKEN=請填入你的_BOT_TOKEN

# 應用程式 Client ID（Developer Portal -> OAuth2 -> Client ID）
CLIENT_ID=請填入你的_CLIENT_ID

# 僅在開發環境使用：填入後指令只註冊到這一個伺服器（即時生效）
# 正式上線請留空（指令會註冊到所有伺服器，需等待數小時）
GUILD_ID=

# 開機時是否自動註冊/更新斜線指令（true / false）
REGISTER_ON_START=true

# 嵌入訊息主要顏色（HEX，不含 #）
COLOR_MAIN=5865F2

# 機器人擁有者 ID（可取得進階權限，可留空）
OWNER_ID=

# 資料儲存目錄（預設 ./data）
DATA_DIR=./data

# 日誌等級：debug / info / warn / error
LOG_LEVEL=info

# 是否啟用音樂功能（需要系統安裝 ffmpeg）
MUSIC_ENABLED=true

# ===== 訊息語言 =====
# both = 中英雙語（預設）｜zh = 僅中文｜en = 僅英文
LANG=both

# ===== 資料庫 =====
# json = 本地 JSON 檔案（預設，data/ 目錄；Docker/Coolify 部署時容器重啟會清空）
# mongodb = MongoDB Atlas（免費 M0）等雲端資料庫，資料不會因重啟消失
DB_TYPE=json
# MongoDB 連線字串（DB_TYPE=mongodb 時必填，從 MongoDB Atlas 取得）
MONGODB_URI=
# MongoDB 資料庫名稱（可留空，預設 disocrd_bot）
MONGODB_NAME=disocrd_bot

# GitHub API Token（可選，GitHub 更新通知功能用；未設定時每小時限 60 次檢查）
# 產生方式：GitHub → Settings → Developer settings → Personal access tokens（選 public_repo 即可）
GITHUB_TOKEN=
# GitHub 更新通知檢查間隔（分鐘，最小 1；愈快愈耗 API 額度）
GITHUB_CHECK_INTERVAL=10

# ===== Privileged Intents 開關 =====
# 對應開發者後台的「Privileged Gateway Intents」三個開關。
# 預設都是 true；若你不想在後台開啟某個 Intent，可設 false 跳過（對應功能會失效）：
#   INTENT_MEMBERS=false          停用成員事件（驗證/歡迎/自動身分組失效）
#   INTENT_MESSAGE_CONTENT=false  停用讀取訊息內容（自動審核/等級/AFK失效）
#   INTENT_PRESENCE=false         停用線上狀態（統計頻道的線上人數會顯示 0）
INTENT_MEMBERS=true
INTENT_MESSAGE_CONTENT=true
INTENT_PRESENCE=true

# ===== 網頁控制面板 =====
# 是否啟用控制面板（true / false）
PANEL_ENABLED=true
# 監聽位址（預設僅本機 127.0.0.1；如要從其他裝置存取請改 0.0.0.0 並務必設定 Token）
PANEL_HOST=127.0.0.1
# 連接埠
PANEL_PORT=3000
# 控制面板存取 Token（留空則每次啟動自動產生並顯示於終端機）
PANEL_TOKEN=
